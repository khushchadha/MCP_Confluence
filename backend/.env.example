# Azure OpenAI — powers the chat agent
AZURE_OPENAI_GPT_4O_API_KEY=your-azure-openai-key
AZURE_OPENAI_GPT_4O_API_VERSION=2024-12-01-preview
AZURE_OPENAI_GPT_4O_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_GPT_4O_DEPLOYMENT_NAME=gpt-4.1

# Confluence — powers the MCP tools
# CONFLUENCE_URL is the site root, without /wiki
CONFLUENCE_URL=https://your-site.atlassian.net
CONFLUENCE_EMAIL=you@example.com
# Create at https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_API_TOKEN=your-api-token
